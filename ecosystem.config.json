{
  "apps": [
    {
      "name": "ai-ethics-forum",
      "script": "npm",
      "args": "start",
      "env": {
        "NODE_ENV": "production"
      }
    },
    {
      "name": "ai-post-scheduler",
      "script": "node_modules/tsx/dist/cli.cjs",
      "args": "scripts/ai-post-scheduler.ts",
      "interpreter": "node",
      "env": {
        "NODE_ENV": "production"
      },
      "watch": false,
      "autorestart": true,
      "max_restarts": 5,
      "restart_delay": 10000
    }
  ]
}
